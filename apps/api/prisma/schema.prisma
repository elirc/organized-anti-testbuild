datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  companies           Company[]
  workers             Worker[]
  contracts           EmploymentContract[]
  onboardingPlans     OnboardingPlan[]
  onboardingTasks     OnboardingTask[]
  documents           Document[]
  payrollCycles       PayrollCycle[]
  payrollItems        PayrollItem[]
  benefitEnrollments  BenefitEnrollment[]
  supportCases        SupportCase[]
  supportCaseComments SupportCaseComment[]
  auditLogs           AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String   // PLATFORM_ADMIN, INTERNAL_OPS, CLIENT_ADMIN, CLIENT_HR, WORKER
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workers             Worker[]
  uploadedDocuments   Document[]           @relation("UploadedBy")
  createdSupportCases SupportCase[]        @relation("CreatedBy")
  assignedSupportCases SupportCase[]       @relation("AssignedTo")
  comments            SupportCaseComment[]
  auditLogs           AuditLog[]

  @@index([tenantId])
}

model Company {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  legalName           String
  industry            String
  headquartersCountry String
  status              String   @default("ACTIVE") // ACTIVE, INACTIVE
  primaryContactName  String
  primaryContactEmail String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workers       Worker[]
  payrollCycles PayrollCycle[]
  supportCases  SupportCase[]

  @@index([tenantId])
}

model Worker {
  id               String   @id @default(uuid())
  tenantId         String
  companyId        String
  userId           String?  @unique
  firstName        String
  lastName         String
  email            String   @unique
  countryCode      String
  jobTitle         String
  department       String
  employmentStatus String   @default("DRAFT") // DRAFT, ONBOARDING, ACTIVE, PAUSED, TERMINATED
  startDate        DateTime
  endDate          DateTime?
  managerName      String?
  managerEmail     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts          EmploymentContract[]
  onboardingPlan     OnboardingPlan?
  documents          Document[]
  payrollItems       PayrollItem[]
  benefitEnrollments BenefitEnrollment[]
  supportCases       SupportCase[]

  @@index([tenantId])
  @@index([companyId])
  @@index([userId])
}

model Country {
  id                    String   @id @default(uuid())
  code                  String   @unique // e.g., "US", "GB", "DE"
  name                  String
  region                String
  currencyCode          String
  payrollFrequency      String
  requiresLocalContract Boolean  @default(true)
  requiresRightToWorkCheck Boolean @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  complianceRequirements ComplianceRequirement[]
  contracts              EmploymentContract[]
  payrollCycles          PayrollCycle[]
}

model ComplianceRequirement {
  id              String   @id @default(uuid())
  countryId       String
  name            String
  description     String
  requirementType String   // DOCUMENT, APPROVAL, POLICY_ACKNOWLEDGEMENT, RIGHT_TO_WORK
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
}

model EmploymentContract {
  id                  String   @id @default(uuid())
  tenantId            String
  workerId            String
  countryId           String
  contractType        String   // FULL_TIME, PART_TIME, FIXED_TERM, CONTRACTOR
  status              String   @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, SENT, SIGNED, ACTIVE, TERMINATED
  compensationAmount  Float
  compensationCurrency String
  effectiveDate       DateTime
  terminationDate     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workerId])
  @@index([countryId])
}

model OnboardingPlan {
  id          String    @id @default(uuid())
  tenantId    String
  workerId    String    @unique
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, BLOCKED, COMPLETED
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  tasks  OnboardingTask[]

  @@index([tenantId])
  @@index([workerId])
}

model OnboardingTask {
  id               String    @id @default(uuid())
  tenantId         String
  onboardingPlanId String
  title            String
  description      String
  taskType         String    // PROFILE_INFO, DOCUMENT_UPLOAD, POLICY_ACK, INTERNAL_REVIEW, CONTRACT_SIGNATURE
  assignedToRole   String    @default("WORKER")
  status           String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, DONE
  dueDate          DateTime
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  onboardingPlan OnboardingPlan @relation(fields: [onboardingPlanId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([onboardingPlanId])
}

model Document {
  id               String   @id @default(uuid())
  tenantId         String
  workerId         String
  uploadedByUserId String
  documentType     String   // PASSPORT, TAX_FORM, CONTRACT, RIGHT_TO_WORK, BANK_INFO, OTHER
  fileName         String
  fileUrl          String
  status           String   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker     Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("UploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workerId])
  @@index([uploadedByUserId])
}

model PayrollCycle {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String
  countryId    String
  periodStart  DateTime
  periodEnd    DateTime
  payDate      DateTime
  status       String   @default("DRAFT") // DRAFT, COLLECTING_INPUTS, REVIEW, APPROVED, PAID, CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country      Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  payrollItems PayrollItem[]

  @@index([tenantId])
  @@index([companyId])
  @@index([countryId])
}

model PayrollItem {
  id             String   @id @default(uuid())
  tenantId       String
  payrollCycleId String
  workerId       String
  grossAmount    Float
  currency       String
  status         String   @default("PENDING") // PENDING, APPROVED, HELD, PAID
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollCycle PayrollCycle @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)
  worker       Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([payrollCycleId])
  @@index([workerId])
}

model BenefitEnrollment {
  id            String    @id @default(uuid())
  tenantId      String
  workerId      String
  benefitType   String    // HEALTH, DENTAL, VISION, RETIREMENT, LIFE_INSURANCE, OTHER
  providerName  String
  status        String    @default("NOT_ELIGIBLE") // NOT_ELIGIBLE, ELIGIBLE, ENROLLED, WAIVED, TERMINATED
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workerId])
}

model SupportCase {
  id               String   @id @default(uuid())
  tenantId         String
  workerId         String?
  companyId        String?
  createdByUserId  String
  assignedToUserId String?
  category         String   // ONBOARDING, PAYROLL, BENEFITS, CONTRACT, DOCUMENTS, GENERAL
  priority         String   // LOW, MEDIUM, HIGH, URGENT
  status           String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_ON_CLIENT, WAITING_ON_WORKER, RESOLVED, CLOSED
  subject          String
  description      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker     Worker?              @relation(fields: [workerId], references: [id], onDelete: SetNull)
  company    Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy  User                 @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedTo User?                @relation("AssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  comments   SupportCaseComment[]

  @@index([tenantId])
  @@index([workerId])
  @@index([companyId])
  @@index([createdByUserId])
  @@index([assignedToUserId])
}

model SupportCaseComment {
  id            String   @id @default(uuid())
  tenantId      String
  supportCaseId String
  authorUserId  String
  body          String
  isInternal    Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportCase SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supportCaseId])
  @@index([authorUserId])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  metadata     String   // SQLite maps String directly, storing JSON as serialized string
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([entityType, entityId])
}
